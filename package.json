{
  "name": "local-responses-api-router",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "A Docker-deployed Responses API router and dashboard.",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 38127",
    "start": "bun .output/server/index.mjs",
    "build:dashboard": "nuxt build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test server/test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@biomejs/biome": "^2.2.0",
    "nuxt": "^4.1.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "vue": "3.5.18"
  }
}
